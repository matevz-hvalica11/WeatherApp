@model List<MyWeatherApp.Models.SearchHistory>
@{
    ViewData["Title"] = "Search History";
}

<div class="main-content">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">🕐 Search History</h2>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-muted mt-5">
            <p class="fs-5">No search history yet.</p>
            <a href="/" class="btn btn-outline-primary mt-2">Search for a city.</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var entry in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card glass h-100 p-4 text-center">
                        <h5 class="fw-bold mb-2">@entry.CityName</h5>
                        <p class="text-muted small mb-3">@entry.SearchedAt.ToString("dd MMM yyyy, HH:mm")</p>
                            <a asp-controller="Weather" asp-action="Index" asp-route-city="@entry.CityName"
                                class="btn btn-outline-primary btn-sm">View Weather</a>
                    </div>
                </div>
            }
        </div>
    }
</div>