@model MyWeatherApp.Models.WeatherHistoryModel
@{
    ViewData["Title"] = "Historical Weather";
}

<div class="history-container fade-in">

    <!-- Header -->
    <div class="header-block">
        <h1 class="city-title">@Model.City</h1>
        <h3 class="date-title">@Model.Date.ToString("yyyy-MM-dd")</h3>
    </div>

    <!-- Daily Summary -->
    <div class="summary-card history-glass animated-card">
        <h2 class="section-title">Daily Summary</h2>

        <div class="summary-grid">
            <div class="summary-item">
                <span class="label">Avg Temp</span>
                <span class="value temp">@Model.AvgTempC °C</span>
            </div>

            <div class="summary-item">
                <span class="label">Max Temp</span>
                <span class="value temp hot">@Model.MaxTempC °C</span>
            </div>

            <div class="summary-item">
                <span class="label">Min Temp</span>
                <span class="value temp cold">@Model.MinTempC °C</span>
            </div>

            <div class="summary-item">
                <span class="label">Humidity</span>
                <span class="value">@Model.AvgHumidity %</span>
            </div>

            <div class="summary-item">
                <span class="label">Precipitation</span>
                <span class="value">@Model.TotalPrecipMm mm</span>
            </div>

        </div>
    </div>


    <!-- Hourly Temperature Chart -->
    <h2 class="section-title mt-5 mb-3 text-center fade-in-delayed">Temperature Chart</h2>

    <div class="history-glass p-4 mb-5">
        <canvas id="hourlyHistoryChart" height="100"></canvas>
    </div>


    <!-- Hourly Breakdown -->
    <h2 class="section-title mt-5 mb-3 text-center fade-in-delayed">Hourly Breakdown</h2>

    <div class="hourly-grid">
        @{ int index = 0; }
        @foreach (var hour in Model.Hourly)
        {
            <div class="hour-card history-glass animated-card" style="animation-delay: @(index * 0.03);">
                <div class="hour-time">@hour.Time.Substring(11)</div>
                <div class="hour-temp temp">@hour.TempC °C</div>
                <div class="mini-metrics">
                    <span>💧 @hour.Humidity %</span>
                    <span>🌧 @hour.PrecipMm mm</span>
                </div>
            </div>
            index++;
        }
    </div>
</div>

@section Scripts {
    <script>
        const hourlyLabels = @Html.Raw(Json.Serialize(Model.Hourly.Select(h => h.Time.Substring(11))));
        const hourlyTemps = @Html.Raw(Json.Serialize(Model.Hourly.Select(h => h.TempC)));
        const ctx = document.getElementById('hourlyHistoryChart');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: hourlyLabels,
                datasets: [{
                    label: 'Temperature (°C)',
                    data: hourlyTemps,
                    borderColor: '#38bdf8',
                    backgroundColor: 'rgba(56,189,248,0.25)',
                    borderWidth: 3,
                    pointRadius: 2,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });
    </script>
}